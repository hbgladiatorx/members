# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# The web app's origin(s), comma-separated. Mobile apps are not affected by CORS.
CORS_ORIGIN=https://members.cimcha.com
# Public https address of the API (used in photo links). Nginx serves it under /api.
PUBLIC_URL=https://members.cimcha.com/api
