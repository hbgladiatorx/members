# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://classes:change-me@localhost:5432/classes
# Optional: enables multi-process Socket.IO broadcasting
# REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Comma-separated list of allowed web origins in production, e.g. https://classes.example.org
CORS_ORIGIN=*
